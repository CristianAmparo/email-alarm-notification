{
  "manifest_version": 3,
  "name": "Chat Alarm",
  "version": "1.0.0",
  "description": "Rings a loud alarm when a Google Chat message matching your filters arrives in Gmail.",
  "permissions": ["storage", "unlimitedStorage", "offscreen", "notifications"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chat Alarm",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "options_page": "options.html"
}
